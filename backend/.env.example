# Copy to .env and fill in. NEVER commit the real .env.

# Flask
# FLASK_ENV=production selects ProductionConfig: debug off, and the app refuses
# to boot if SECRET_KEY / JWT_SECRET / FERNET_KEY are missing or left at the
# placeholders below. Anything else (or unset) = development.
# FLASK_ENV=production
SECRET_KEY=change-me

# Database — Postgres, from docker-compose.yml (user/pass/db all "orange").
# This is also the built-in default, so the app points here even without a .env.
# There is no SQLite fallback: start the databases with `docker compose up -d`.
DATABASE_URL=postgresql+psycopg://orange:orange@localhost:5432/orange

# JWT
JWT_SECRET=change-me
JWT_HOURS=12

# Fernet key for encrypting provider API keys at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# Qdrant — the server from docker-compose.yml. Also the built-in default.
# There is no embedded/on-disk mode: if this server is unreachable the app fails
# loudly rather than writing vectors to a local store nobody reads.
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# CORS (Angular dev server)
CORS_ORIGINS=http://localhost:4200

# Retrieval relevance threshold (Phase 9). Qdrant scores are NOT percentages —
# calibrate with 20–30 real queries. Chunks below this are treated as "no match".
# 0.0 = keep everything (default until calibrated).
SEARCH_SCORE_THRESHOLD=0.0

# Free-only guardrail. When true (default), only free-tier providers can be
# registered or called — this platform has no billing. Set to false ONLY if you
# have real billing and deliberately want to allow paid providers.
FREE_ONLY=true

# --- Failing fast on a dead provider ---
# LiteLLM retries a failing provider internally unless told not to, which is how a
# dead key turned into a 42.9-second wait: the customer watches a spinner while we
# quietly re-try the same broken endpoint. A provider that cannot answer within the
# timeout is treated as failed and greys out in the model dropdown, saying so.
# Raise the TIMEOUT if a legitimately slow model is being cut off — do NOT raise the
# retries, which only multiplies the wait.
LLM_TIMEOUT_SECONDS=15
LLM_NUM_RETRIES=0

# Provider fallback. When a chosen model is at its rate ceiling, should the query be
# answered by the next provider instead? Default OFF: the customer picked a model,
# and quietly answering with a different one is a surprise, not a service. With it
# off, a model at capacity greys out and the customer chooses another themselves.
# PROVIDER_FALLBACK_ENABLED=false

# --- LLM provider keys (used only by `python -m app.seed_providers`) ---
# Free-tier keys for the demo providers. Leave blank to skip that provider.
# Gemini:      https://aistudio.google.com/apikey
# Groq:        https://console.groq.com/keys
# Mistral:     https://console.mistral.ai/api-keys
# OpenRouter:  https://openrouter.ai/keys
# Cerebras:    https://cloud.cerebras.ai
# NVIDIA NIM:  https://build.nvidia.com
#
# NOTE: providers sharing ONE key automatically share ONE rate-limit budget — the
# RPM/RPD ceiling belongs to the account, not to the registry row (usage.py).
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
